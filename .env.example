# One OpenAI-compatible provider
# OPSHUB_AI_NAME=OpenAI
# OPSHUB_AI_ENDPOINT=https://api.openai.com/v1
# OPSHUB_AI_API_KEY=replace_me
# OPSHUB_AI_MODEL=gpt-5.4-mini

# Or configure several providers as a JSON array. Keep real keys in a local environment, never commit them.
# OPSHUB_AI_PROVIDERS_JSON=[{"name":"OpenAI","endpoint":"https://api.openai.com/v1","apiKey":"replace_me","model":"gpt-5.4-mini"},{"name":"DeepSeek","endpoint":"https://api.deepseek.com/v1","apiKey":"replace_me","model":"deepseek-chat"}]

# BaoTa Node project manager port. Open 3000 in both the BaoTa firewall and Alibaba Cloud security group.
PORT=3000
# BaoTa local MySQL connection. Do not expose MySQL publicly.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=replace_with_baota_database_user
MYSQL_PASS=replace_with_baota_database_password
MYSQL_DB=ops_box
# Required when using docker compose. Use a different strong value from MYSQL_PASS.
MYSQL_ROOT_PASS=replace_with_a_strong_mysql_root_password
# Use a long random value in BaoTa's project environment variables or this local .env file.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES=7d
# Leave empty for same-origin requests only. For a separate frontend, use a comma-separated allowlist.
# CORS_ORIGINS=https://ops.example.com
# QQ Mail SMTP with SSL on 465 avoids Alibaba Cloud's port 25 restriction.
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USER=sender@example.com
EMAIL_PASS=replace_with_email_authorization_code
EMAIL_FROM=运维百宝箱<sender@example.com>
