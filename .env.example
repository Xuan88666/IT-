# One OpenAI-compatible provider
# OPSHUB_AI_NAME=OpenAI
# OPSHUB_AI_ENDPOINT=https://api.openai.com/v1
# OPSHUB_AI_API_KEY=replace_me
# OPSHUB_AI_MODEL=gpt-5.4-mini

# Or configure several providers as a JSON array. Keep real keys in a local environment, never commit them.
# OPSHUB_AI_PROVIDERS_JSON=[{"name":"OpenAI","endpoint":"https://api.openai.com/v1","apiKey":"replace_me","model":"gpt-5.4-mini"},{"name":"DeepSeek","endpoint":"https://api.deepseek.com/v1","apiKey":"replace_me","model":"deepseek-chat"}]
